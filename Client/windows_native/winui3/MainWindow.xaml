<Window
    x:Class="SuperWebClient.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SuperWebClient.WinUI3.Models"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="12" UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="356" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="344" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource RailBackgroundBrush}"
                BorderBrush="{StaticResource ShellDividerBrush}"
                BorderThickness="1"
                CornerRadius="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="16,18,16,12" Spacing="12">
                        <Button Style="{StaticResource RailIconButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="Right">
                                    <Border
                                        Width="316"
                                        Background="{StaticResource CardSurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="26"
                                        Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Connect to main node" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock
                                                Text="Connection entry is tucked into the logo dropdown to keep the Fluent main surface uncluttered."
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBox x:Name="ClientNameTextBox" Header="Client name" Text="windows winui3 client" />
                                            <TextBox x:Name="HostOverrideTextBox" Header="Host override (optional)" PlaceholderText="Leave empty to use mDNS discovery" />
                                            <TextBox x:Name="PortTextBox" Header="TCP port" Text="52020" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Discover / Connect" Click="ConnectButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Content="Disconnect" Click="DisconnectButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ConnectionStatusText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <Border
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource CardSurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                                <Image
                                    x:Name="BrandmarkImage"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="UniformToFill" />
                            </Border>
                        </Button>

                        <Button
                            x:Name="ConversationsRailButton"
                            AutomationProperties.Name="Show recent conversations"
                            Background="{x:Bind ConversationsRailButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ConversationsRailButtonBorderBrush, Mode=OneWay}"
                            Click="ConversationsRailButton_Click"
                            Foreground="{x:Bind ConversationsRailButtonForeground, Mode=OneWay}"
                            Style="{StaticResource RailIconButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Show recent conversations" />
                            </ToolTipService.ToolTip>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;" />
                        </Button>
                        <Button
                            x:Name="ContactsRailButton"
                            AutomationProperties.Name="Show compute methods"
                            Background="{x:Bind ContactsRailButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ContactsRailButtonBorderBrush, Mode=OneWay}"
                            Click="ContactsRailButton_Click"
                            Foreground="{x:Bind ContactsRailButtonForeground, Mode=OneWay}"
                            Style="{StaticResource RailIconButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Show compute methods" />
                            </ToolTipService.ToolTip>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;" />
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Width="34"
                        Height="34"
                        Margin="0,12,0,18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{x:Bind ConnectionIndicatorPanelBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind ConnectionIndicatorBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="17">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind FooterStatusText, Mode=OneWay}" />
                        </ToolTipService.ToolTip>
                        <Ellipse
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{x:Bind ConnectionIndicatorBrush, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Background="{StaticResource ConversationPaneBrush}"
                BorderBrush="{StaticResource ShellDividerBrush}"
                BorderThickness="1"
                CornerRadius="30">
                <Grid Padding="18,18,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource SearchSurfaceBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Glyph="&#xE721;" />
                            <TextBox
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                PlaceholderText="{x:Bind SidebarSearchPlaceholderText, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,18,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{x:Bind SidebarSectionTitle, Mode=OneWay}" />

                    <ListView
                        x:Name="ConversationList"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{x:Bind Conversations, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="ConversationList_SelectionChanged"
                        Visibility="{x:Bind ConversationListVisibility, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ConversationPreview">
                                <Border
                                    Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="42"
                                            Height="42"
                                            Background="{x:Bind AvatarBackground}"
                                            CornerRadius="16">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind AvatarForeground}"
                                                Text="{x:Bind Initials}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource PrimaryTextBrush}"
                                                    Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{x:Bind Timestamp}" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="{x:Bind Presence}" />
                                            <TextBlock
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                Opacity="0.82"
                                                Text="{x:Bind Snippet}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource UnreadBadgeBrush}"
                                            CornerRadius="12"
                                            Padding="8,2"
                                            Visibility="{x:Bind BadgeVisibility}">
                                            <TextBlock
                                                Foreground="{StaticResource UnreadBadgeForegroundBrush}"
                                                Text="{x:Bind BadgeText}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView
                        x:Name="ContactList"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{x:Bind Contacts, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="ContactList_SelectionChanged"
                        Visibility="{x:Bind ContactListVisibility, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ContactProfile">
                                <Border
                                    Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="14,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="42"
                                            Height="42"
                                            Background="{x:Bind AvatarBackground}"
                                            CornerRadius="16">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind AvatarForeground}"
                                                Text="{x:Bind Initials}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                Text="{x:Bind Title}" />
                                            <TextBlock
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="{x:Bind Subtitle}" />
                                            <TextBlock
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                Opacity="0.82"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="18,18,18,12" Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="52"
                        Height="52"
                        Background="{x:Bind ActiveConversationAvatarBackground, Mode=OneWay}"
                        CornerRadius="18">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind ActiveConversationAvatarForeground, Mode=OneWay}"
                            Text="{x:Bind ActiveConversationInitials, Mode=OneWay}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Bind ActiveConversationTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind ActiveConversationSubtitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind ActiveConversationDetailNote, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ToolbarIconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72D;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="18,0,18,12"
                Background="{StaticResource ChatCanvasBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="32"
                Padding="10">
                <ListView
                    x:Name="MessagesView"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind Messages, Mode=OneWay}"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessage">
                            <Grid HorizontalAlignment="Stretch" Margin="{x:Bind OuterMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="{x:Bind ColumnIndex}"
                                    HorizontalAlignment="{x:Bind Alignment}"
                                    MaxWidth="640"
                                    Spacing="4">
                                    <TextBlock Text="{x:Bind Header}" FontWeight="SemiBold" Opacity="0.72" Visibility="{x:Bind HeaderVisibility}" />
                                    <Border
                                        Background="{x:Bind BubbleBackground}"
                                        BorderBrush="{x:Bind BubbleBorder}"
                                        BorderThickness="1"
                                        CornerRadius="22"
                                        Padding="14,10">
                                        <TextBlock Foreground="{x:Bind Foreground}" Text="{x:Bind Body}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button
                                        Click="MessageActionButton_Click"
                                        Content="{x:Bind ActionText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Tag="{x:Bind ActionTargetPath}"
                                        Visibility="{x:Bind ActionVisibility}" />
                                    <TextBlock FontSize="12" Opacity="0.58" Text="{x:Bind Meta}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Row="2" Margin="18,0,18,18" Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{x:Bind ComposerHintText, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <Border
                        Background="{StaticResource SearchSurfaceBrush}"
                        BorderBrush="{StaticResource SearchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,12"
                        Visibility="{x:Bind RequestSummaryVisibility, Mode=OneWay}">
                        <TextBlock
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Bind RequestSummaryText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>

                    <TextBox
                        x:Name="ManualInputTextBox"
                        AcceptsReturn="True"
                        MinHeight="110"
                        PlaceholderText="Type free content here"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind TextComposerVisibility, Mode=OneWay}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{x:Bind ConnectionIndicatorPanelBrush, Mode=OneWay}"
                            BorderBrush="{x:Bind ConnectionIndicatorBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="15">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind FooterStatusText, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                            <Ellipse
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ConnectionIndicatorBrush, Mode=OneWay}" />
                        </Border>

                        <Button
                            Grid.Column="1"
                            Click="PrimaryActionButton_Click"
                            Content="{x:Bind PrimaryActionText, Mode=OneWay}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Column="2"
            Background="{StaticResource DetailPaneBrush}"
            BorderBrush="{StaticResource ShellDividerBrush}"
            BorderThickness="1"
            CornerRadius="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="18" Spacing="16">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Route" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind RouteTitleText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind RouteDetailText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind GemvSizeVisibility, Mode=OneWay}">
                                <TextBlock Text="GEMV matrix size" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="GemvSizeComboBox" SelectedIndex="2" SelectionChanged="GemvSizeComboBox_SelectionChanged" Style="{StaticResource RoundedInputComboBoxStyle}">
                                    <ComboBoxItem Content="small" />
                                    <ComboBoxItem Content="mid" />
                                    <ComboBoxItem Content="large" />
                                </ComboBox>
                            </StackPanel>
                            <TextBox x:Name="ObjectIdTextBox" Header="Object id (optional)" Style="{StaticResource RoundedInputTextBoxStyle}" TextChanged="ObjectIdTextBox_TextChanged" />
                            <TextBox x:Name="StreamIdTextBox" Header="Stream id (optional)" Style="{StaticResource RoundedInputTextBoxStyle}" TextChanged="StreamIdTextBox_TextChanged" />
                            <StackPanel Spacing="8" Visibility="{x:Bind Conv2dSettingsVisibility, Mode=OneWay}">
                                <TextBlock Text="Conv2d workload size" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="Conv2dSizeComboBox" SelectedIndex="0" SelectionChanged="Conv2dSizeComboBox_SelectionChanged" Style="{StaticResource RoundedInputComboBoxStyle}">
                                    <ComboBoxItem Content="small" />
                                    <ComboBoxItem Content="mid" />
                                    <ComboBoxItem Content="large" />
                                </ComboBox>
                                <ToggleSwitch
                                    x:Name="Conv2dStatsOnlyToggle"
                                    Header="Stats-only response"
                                    Toggled="Conv2dStatsOnlyToggle_Toggled" />
                                <TextBox
                                    x:Name="Conv2dDownloadNameTextBox"
                                    Header="Download name (optional)"
                                    PlaceholderText="Leave empty for an auto-generated local file name"
                                    Style="{StaticResource RoundedInputTextBoxStyle}"
                                    TextChanged="Conv2dDownloadNameTextBox_TextChanged" />
                                <TextBox
                                    x:Name="Conv2dStatsMaxSamplesTextBox"
                                    Header="Max stats samples"
                                    Style="{StaticResource RoundedInputTextBoxStyle}"
                                    Text="16"
                                    TextChanged="Conv2dStatsMaxSamplesTextBox_TextChanged" />
                                <TextBlock
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="Stats-only mode skips the full local download and asks the cluster for merged output statistics instead."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Automation" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Automation stays pinned to the right pane and follows the current conversation's method."
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind VectorSeedVisibility, Mode=OneWay}">
                                <TextBlock Text="32K vector seed" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="VectorSeedTextBox" Style="{StaticResource RoundedInputTextBoxStyle}" Text="0x0FEDCBA987654321" />
                            </StackPanel>
                            <TextBox x:Name="IterationCountTextBox" Header="Iteration count per request" Style="{StaticResource RoundedInputTextBoxStyle}" Text="1" />
                            <StackPanel Spacing="8" Visibility="{x:Bind AutoContentVisibility, Mode=OneWay}">
                                <TextBlock Text="Auto text content" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox
                                    x:Name="AutoContentTextBox"
                                    AcceptsReturn="True"
                                    MinHeight="96"
                                    Style="{StaticResource RoundedInputTextBoxStyle}"
                                    Text="hello from superweb-client WinUI3"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Start auto send" Click="StartAutoSendButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Stop" Click="StopAutoSendButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Cluster" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind ConnectionStatusText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ClusterHealthText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
