<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandBlueColor">#FF6667AB</Color>
    <Color x:Key="BrandSkyColor">#FF8B8CC9</Color>
    <Color x:Key="BrandSlateColor">#FF24253A</Color>
    <Color x:Key="BrandMistColor">#FFF1F2FA</Color>
    <Color x:Key="BrandIceColor">#FFF8F8FD</Color>
    <Color x:Key="BrandWarmWhiteColor">#FFFFFFFF</Color>
    <Color x:Key="BrandWarningColor">#FFFFF4D8</Color>
    <Color x:Key="BrandWarningBorderColor">#FFECDCA5</Color>
    <Color x:Key="BubblePinkColor">#FFDECDBE</Color>
    <Color x:Key="BubblePinkBorderColor">#FFCDBCAE</Color>
    <Color x:Key="BrandCardBorderColor">#FFD7D9EC</Color>
    <Color x:Key="BrandMutedTextColor">#FF73769A</Color>
    <Color x:Key="BrandPrimaryTextColor">#FF1B1D2E</Color>
    <Color x:Key="StatusConnectedColor">#FF4FCB83</Color>
    <Color x:Key="StatusConnectedBorderColor">#FF3EAA6A</Color>
    <Color x:Key="StatusConnectedPanelColor">#334FCB83</Color>
    <Color x:Key="StatusDisconnectedColor">#FFE0626E</Color>
    <Color x:Key="StatusDisconnectedBorderColor">#FFC94C58</Color>
    <Color x:Key="StatusDisconnectedPanelColor">#33E0626E</Color>
    <Color x:Key="WechatGreenColor">#FF6667AB</Color>
    <Color x:Key="WechatGreenBorderColor">#FF595A97</Color>
    <Color x:Key="ShellBackgroundColor">#00EEF0F8</Color>
    <Color x:Key="RailBackgroundColor">#68F5F6FC</Color>
    <Color x:Key="ConversationPaneColor">#5EF7F8FD</Color>
    <Color x:Key="DetailPaneColor">#58FAFAFE</Color>
    <Color x:Key="SearchSurfaceColor">#8FFFFFFF</Color>
    <Color x:Key="SearchBorderColor">#FFD9DBEF</Color>
    <Color x:Key="ToolbarButtonColor">#8CFFFFFF</Color>
    <Color x:Key="ToolbarButtonHoverColor">#FFECEDFC</Color>
    <Color x:Key="UnreadBadgeColor">#FFFF5D5B</Color>
    <Color x:Key="AvatarTealColor">#FF7D7EC2</Color>
    <Color x:Key="AvatarBlueColor">#FF6667AB</Color>
    <Color x:Key="AvatarOrangeColor">#FF8D8ED0</Color>
    <Color x:Key="AvatarPinkColor">#FF7678BC</Color>
    <Color x:Key="AvatarOliveColor">#FF585A96</Color>
    <Color x:Key="PaneTintColor">#5EF7F8FD</Color>
    <Color x:Key="CardTintColor">#78FFFFFF</Color>
    <Color x:Key="SearchTintColor">#8FFFFFFF</Color>
    <Color x:Key="ToolbarTintColor">#8CF7F7FD</Color>

    <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlueColor}" />
    <SolidColorBrush x:Key="BrandSkyBrush" Color="{StaticResource BrandSkyColor}" />
    <SolidColorBrush x:Key="BrandSlateBrush" Color="{StaticResource BrandSlateColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource BrandMutedTextColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource BrandPrimaryTextColor}" />
    <SolidColorBrush x:Key="StatusConnectedBrush" Color="{StaticResource StatusConnectedColor}" />
    <SolidColorBrush x:Key="StatusConnectedBorderBrush" Color="{StaticResource StatusConnectedBorderColor}" />
    <SolidColorBrush x:Key="StatusConnectedPanelBrush" Color="{StaticResource StatusConnectedPanelColor}" />
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{StaticResource StatusDisconnectedColor}" />
    <SolidColorBrush x:Key="StatusDisconnectedBorderBrush" Color="{StaticResource StatusDisconnectedBorderColor}" />
    <SolidColorBrush x:Key="StatusDisconnectedPanelBrush" Color="{StaticResource StatusDisconnectedPanelColor}" />
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{StaticResource ShellBackgroundColor}" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#62F5F6FC" />
    <SolidColorBrush x:Key="ConversationPaneBrush" Color="#58F7F8FD" />
    <SolidColorBrush x:Key="DetailPaneBrush" Color="#52FAFAFE" />
    <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#88FFFFFF" />
    <SolidColorBrush x:Key="SearchBorderBrush" Color="{StaticResource SearchBorderColor}" />
    <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#84FFFFFF" />
    <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="{StaticResource ToolbarButtonHoverColor}" />
    <SolidColorBrush x:Key="ShellDividerBrush" Color="{StaticResource BrandCardBorderColor}" />
    <SolidColorBrush x:Key="UnreadBadgeBrush" Color="{StaticResource UnreadBadgeColor}" />
    <SolidColorBrush x:Key="UnreadBadgeForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComposerSurfaceBrush" Color="#84FFFFFF" />
    <SolidColorBrush x:Key="AvatarTealBrush" Color="{StaticResource AvatarTealColor}" />
    <SolidColorBrush x:Key="AvatarBlueBrush" Color="{StaticResource AvatarBlueColor}" />
    <SolidColorBrush x:Key="AvatarOrangeBrush" Color="{StaticResource AvatarOrangeColor}" />
    <SolidColorBrush x:Key="AvatarPinkBrush" Color="{StaticResource AvatarPinkColor}" />
    <SolidColorBrush x:Key="AvatarOliveBrush" Color="{StaticResource AvatarOliveColor}" />
    <SolidColorBrush x:Key="AvatarLetterBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="ChatCanvasBrush" Color="#12FFFFFF" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ConversationPaneColor}" Offset="0" />
        <GradientStop Color="#FFF4F4F4" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClusterGreenBrush" Color="{StaticResource WechatGreenColor}" />
    <SolidColorBrush x:Key="ClusterGreenBorderBrush" Color="{StaticResource WechatGreenBorderColor}" />
    <SolidColorBrush x:Key="PeerBubbleBrush" Color="{StaticResource BubblePinkColor}" />
    <SolidColorBrush x:Key="PeerBubbleBorderBrush" Color="{StaticResource BubblePinkBorderColor}" />
    <SolidColorBrush x:Key="SystemBubbleBrush" Color="{StaticResource BubblePinkColor}" />
    <SolidColorBrush x:Key="SystemBubbleBorderBrush" Color="{StaticResource BubblePinkBorderColor}" />
    <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource BubblePinkColor}" />
    <SolidColorBrush x:Key="UserBubbleBorderBrush" Color="{StaticResource BubblePinkBorderColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BrandCardBorderColor}" />

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ClusterGreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandSlateBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="42" />
    </Style>

    <Style x:Key="RoundedInputTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{StaticResource SearchSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="RoundedInputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{StaticResource SearchSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="RailIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{StaticResource ToolbarButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource ToolbarButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SearchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
